# SPDX-License-Identifier: GPL-2.0-only
#
# POCO F7 (onyx / SM8735 tuna) vendor fragment for CLO KERNEL.PLATFORM.5.0
# (Linux 6.12.92 pure GKI + KP 5.0 soc-repo).
#
# Zero-KABI-Break Policy:
#   - Preserve CONFIG_ANDROID_KABI_RESERVE=y, CONFIG_MODVERSIONS=y,
#     CONFIG_GENDWARFKSYMS=y, and CONFIG_DEBUG_INFO=y from gki_defconfig.
#   - Keep pure GKI 6.12 vmlinux struct layouts intact (no core struct edits).

# --- Kernel release identity (zero KABI impact; matches 6.6 onyx suffix) ---
CONFIG_LOCALVERSION="-Drago"

# --- Production build mode: Clang Full LTO + Rust kept alive ---
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_FULL=y
# CONFIG_LTO_CLANG_THIN is not set
# init/Kconfig gates CONFIG_RUST on:
#   1) (!DEBUG_INFO_BTF || !LTO)
#   2) (!MODVERSIONS || GENDWARFKSYMS), where GENDWARFKSYMS depends on !LTO
# Disable both BTF and MODVERSIONS (matching 6.6 max-perf parity; all .ko
# modules are rebuilt together from this tree) so CONFIG_RUST=y and
# rust_binder.ko stay active under Full LTO, and drop DWARF5 for fast LTO link.
# CONFIG_MODVERSIONS is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# Avoid cross-LLVM-minor llvm-link bitcode mismatch between clang-r563880c (21.0)
# and AOSP rustc 1.93.1 (21.1.8); keeps CONFIG_RUST=y and rust_binder.ko intact.
# CONFIG_RUST_INLINE_HELPERS is not set

# --- Full 6.6 Max-Perf Parity: strip compile-time hardening & CPU mitigations ---
# All modules (system_dlkm + vendor_dlkm) are built from this tree against this
# exact config, so there is zero mixed-ABI exposure.
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_HARDENED_USERCOPY is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# Core kernel runs without stack zero-init; Makefile preserves
# -ftrivial-auto-var-init=zero for KBUILD_EXTMOD out-of-tree QCOM modules.
CONFIG_INIT_STACK_NONE=y
# CONFIG_INIT_STACK_ALL_ZERO is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_SHUFFLE_PAGE_ALLOCATOR is not set
# CONFIG_KFENCE is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_VMALLOC is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_BOUNDS is not set
# CONFIG_UBSAN_ARRAY_BOUNDS is not set
# CONFIG_FORTIFY_SOURCE is not set
# CONFIG_LIST_HARDENED is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY is not set
# CONFIG_ARM64_SW_TTBR0_PAN is not set
# CONFIG_ARM64_E0PD is not set
# CONFIG_RODATA_FULL_DEFAULT_ENABLED is not set

# --- Strip debug/accounting/compat/foreign-CPU errata overhead (6.6 parity) ---
# CONFIG_TRACE_MMIO_ACCESS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_CPU_FREQ_TIMES is not set
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_COMPAT is not set
# CONFIG_ARMV8_DEPRECATED is not set
# CONFIG_SWP_EMULATION is not set
# CONFIG_CP15_BARRIER_EMULATION is not set
# CONFIG_SETEND_EMULATION is not set
# CONFIG_F2FS_IOSTAT is not set
# CONFIG_F2FS_STAT_FS is not set
# CONFIG_DMABUF_SYSFS_STATS is not set
# CONFIG_BLK_DEV_THROTTLING is not set
# CONFIG_BLK_CGROUP_IOCOST is not set
# CONFIG_TASKSTATS is not set
# CONFIG_TASK_DELAY_ACCT is not set
# CONFIG_TASK_IO_ACCOUNTING is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_BPF_LSM is not set
# CONFIG_STATIC_USERMODEHELPER is not set
# CONFIG_INTEGRITY_AUDIT is not set
# CONFIG_DAMON is not set
# CONFIG_DAMON_VADDR is not set
# CONFIG_DAMON_PADDR is not set
# CONFIG_DAMON_SYSFS is not set
CONFIG_KPROBES=y
# CONFIG_UPROBES is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_QCOM_HUNG_TASK_ENH is not set
# CONFIG_SECURITY_SELINUX_AVC_STATS is not set
# CONFIG_COREDUMP is not set
# CONFIG_PRINTK_CALLER is not set
# CONFIG_STACKTRACE_BUILD_ID is not set
# CONFIG_NETFILTER_XT_TARGET_TRACE is not set
# CONFIG_PROFILING is not set
# Strip foreign ARM64 errata (keep 3194386 & 4118414 for Cortex-X4/A720 silicon)
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_ARM64_ERRATUM_1024718 is not set
# CONFIG_ARM64_ERRATUM_1530923 is not set
# CONFIG_ARM64_ERRATUM_2441007 is not set
# CONFIG_ARM64_ERRATUM_832075 is not set
# CONFIG_ARM64_ERRATUM_834220 is not set
# CONFIG_ARM64_ERRATUM_1319367 is not set
# CONFIG_ARM64_ERRATUM_858921 is not set
# CONFIG_ARM64_ERRATUM_1165522 is not set
# CONFIG_ARM64_ERRATUM_1286807 is not set
# CONFIG_ARM64_ERRATUM_1463225 is not set
# CONFIG_ARM64_ERRATUM_1508412 is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set
# CONFIG_ARM64_ERRATUM_2051678 is not set
# CONFIG_ARM64_ERRATUM_2077057 is not set
# CONFIG_ARM64_ERRATUM_2457168 is not set
# CONFIG_ARM64_ERRATUM_2658417 is not set
# CONFIG_ARM64_ERRATUM_3117295 is not set
# CONFIG_ARM64_ERRATUM_2054223 is not set
# CONFIG_ARM64_ERRATUM_2067961 is not set
# CONFIG_ARM64_ERRATUM_2645198 is not set
# CONFIG_ARM64_ERRATUM_2966298 is not set
# CONFIG_ARM64_ERRATUM_4311569 is not set
# CONFIG_ARM64_ERRATUM_4193714 is not set

# --- SM8735 (TUNA) platform & Niobe UFS PHY ---
CONFIG_ARCH_TUNA=y
CONFIG_PINCTRL_TUNA=m
CONFIG_INTERCONNECT_QCOM_TUNA=m
CONFIG_PHY_QCOM_UFS_V4_NIOBE=m
CONFIG_SM_GCC_TUNA=m
CONFIG_SM_TCSRCC_TUNA=m
CONFIG_SM_DISPCC_TUNA=m
CONFIG_SM_GPUCC_TUNA=m
CONFIG_SM_CAMCC_TUNA=m
CONFIG_SM_CAMBISTMCLKCC_TUNA=m
CONFIG_SM_VIDEOCC_TUNA=m
CONFIG_SM_EVACC_TUNA=m
CONFIG_SM_DEBUGCC_TUNA=m

# Drop foreign SUN-only clock/pinctrl/icc/ufs-phy modules (onyx DT uses qcom,tuna + niobe)
# CONFIG_PINCTRL_SUN is not set
# CONFIG_INTERCONNECT_QCOM_SUN is not set
# CONFIG_SM_GCC_SUN is not set
# CONFIG_SM_TCSRCC_SUN is not set
# CONFIG_SM_DISPCC_SUN is not set
# CONFIG_SM_GPUCC_SUN is not set
# CONFIG_SM_CAMCC_SUN is not set
# CONFIG_SM_CAMBISTMCLKCC_SUN is not set
# CONFIG_SM_VIDEOCC_SUN is not set
# CONFIG_SM_EVACC_SUN is not set
# CONFIG_SM_DEBUGCC_SUN is not set
# CONFIG_PHY_QCOM_UFS_V4_SUN is not set
# CONFIG_PHY_QCOM_UFS_QRBTC_SDM845 is not set

# External wlan/platform builds cnss2.ko; disable in-tree duplicate
# CONFIG_CNSS2 is not set

# --- Xiaomi onyx hardware drivers ---
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_FOD_FINGERPRINT=y
CONFIG_IR_SPI=m
CONFIG_SIH_VIBRATOR=m
CONFIG_INPUT_AW86927_HAPTIC=m
