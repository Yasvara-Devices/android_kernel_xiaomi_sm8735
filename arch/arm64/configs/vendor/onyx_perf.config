# SPDX-License-Identifier: GPL-2.0-only
#
# POCO F7 (onyx / SM8735 tuna) vendor fragment for CLO KERNEL.PLATFORM.5.0
# (Linux 6.12.92 pure GKI + KP 5.0 soc-repo).
#
# Zero-KABI-Break Policy:
#   - Preserve CONFIG_ANDROID_KABI_RESERVE=y, CONFIG_MODVERSIONS=y,
#     CONFIG_GENDWARFKSYMS=y, and CONFIG_DEBUG_INFO=y from gki_defconfig.
#   - Keep pure GKI 6.12 vmlinux struct layouts intact (no core struct edits).

# --- Build mode (temporary LTO_NONE for fast bring-up; restore LTO_CLANG_FULL before ship) ---
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# Prebuilt kernel-build-tools libdw.so lacks zstd decompression; keep DWARF
# uncompressed so gendwarfksyms reads all DWARF5 units cleanly (0 KABI impact).
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_COMPRESSED_ZSTD is not set
# Avoid cross-LLVM-minor llvm-link bitcode mismatch between clang-r563880c (21.0)
# and AOSP rustc 1.93.1 (21.1.8); keeps CONFIG_RUST=y and rust_binder.ko intact.
# CONFIG_RUST_INLINE_HELPERS is not set
# Bring-up diagnostics (0 KABI impact): keep CFI_CLANG=y and UBSAN=y active,
# but report violations in dmesg instead of immediately trapping/rebooting so
# any legacy vendor/external module mismatches can be identified and fixed.
CONFIG_CFI_PERMISSIVE=y
# CONFIG_UBSAN_TRAP is not set

# --- SM8735 (TUNA) platform & Niobe UFS PHY ---
CONFIG_ARCH_TUNA=y
CONFIG_PINCTRL_TUNA=m
CONFIG_INTERCONNECT_QCOM_TUNA=m
CONFIG_PHY_QCOM_UFS_V4_NIOBE=m
CONFIG_SM_GCC_TUNA=m
CONFIG_SM_TCSRCC_TUNA=m
CONFIG_SM_DISPCC_TUNA=m
CONFIG_SM_GPUCC_TUNA=m
CONFIG_SM_CAMCC_TUNA=m
CONFIG_SM_CAMBISTMCLKCC_TUNA=m
CONFIG_SM_VIDEOCC_TUNA=m
CONFIG_SM_EVACC_TUNA=m
CONFIG_SM_DEBUGCC_TUNA=m

# Drop foreign SUN-only clock/pinctrl/icc/ufs-phy modules (onyx DT uses qcom,tuna + niobe)
# CONFIG_PINCTRL_SUN is not set
# CONFIG_INTERCONNECT_QCOM_SUN is not set
# CONFIG_SM_GCC_SUN is not set
# CONFIG_SM_TCSRCC_SUN is not set
# CONFIG_SM_DISPCC_SUN is not set
# CONFIG_SM_GPUCC_SUN is not set
# CONFIG_SM_CAMCC_SUN is not set
# CONFIG_SM_CAMBISTMCLKCC_SUN is not set
# CONFIG_SM_VIDEOCC_SUN is not set
# CONFIG_SM_EVACC_SUN is not set
# CONFIG_SM_DEBUGCC_SUN is not set
# CONFIG_PHY_QCOM_UFS_V4_SUN is not set
# CONFIG_PHY_QCOM_UFS_QRBTC_SDM845 is not set

# External wlan/platform builds cnss2.ko; disable in-tree duplicate
# CONFIG_CNSS2 is not set

# --- Xiaomi onyx hardware drivers ---
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_FOD_FINGERPRINT=y
CONFIG_IR_SPI=m
CONFIG_SIH_VIBRATOR=m
CONFIG_INPUT_AW86927_HAPTIC=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_AWRGB21024=m
CONFIG_MI_T1_CHIP=m
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=m
CONFIG_MI_BOOT_TIME=m
CONFIG_MI_BOOT_MONITOR=m
CONFIG_MI_HARDWARE_ID=m
CONFIG_MIEV=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# --- Xiaomi MCA 120W charging stack (replaces stock QTI battery charger) ---
# CONFIG_QTI_BATTERY_CHARGER is not set
CONFIG_XM_POWER_SUPPLY=m
CONFIG_CHARGER_PARTITION=m
CONFIG_MCA_PROTOCOL_PD=m
CONFIG_MCA_PROTOCOL_QC=m
CONFIG_MCA_EXTERNAL_FG=m
CONFIG_MCA_EXTERNAL_CP=m
CONFIG_MCA_EXTERNAL_WIRELESS=m
CONFIG_MCA_EXTERNAL_BOOST=m
CONFIG_MCA_EXTERNAL_CP_SC8541=m
CONFIG_MCA_EXTERNAL_WIRELESS_SC96281=m
CONFIG_MCA_EXTERNAL_LOADSWITCH=m
CONFIG_MCA_QCOM_SUBPMIC=m
CONFIG_MCA_QCOM_ADSP=m
CONFIG_MCA_QCOM_SYSFS=m
CONFIG_MCA_QCOM_SMEM=m
CONFIG_MCA_QCOM_PANEL=m
# CONFIG_MCA_UT_TEST is not set

# --- Scheduler, Memory, Networking & Runtime Tuning (zero KABI drift) ---
CONFIG_PID_IN_CONTEXTIDR=y
CONFIG_SCHED_CLUSTER=y
CONFIG_PM_USERSPACE_AUTOSLEEP=y
CONFIG_THERMAL_STATISTICS=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
CONFIG_PANIC_TIMEOUT=5

# --- SM8735 / onyx SoC hardware drivers omitted by KP 5.0 sun_perf.bzl ---
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_USB_MSM_EUSB2_PHY=m
CONFIG_QCOM_FSA4480_I2C=m
CONFIG_QCOM_QFPROM_SYS=m
CONFIG_COMMON_CLK_SCMI=m
CONFIG_QCOM_CPUSS_SLEEP_STATS=m
CONFIG_QCOM_CPUSS_SLEEP_STATS_V4=m
CONFIG_QCOM_GLINK=m
CONFIG_QCOM_LLCC_HEURISTICS=m
CONFIG_QCOM_MEM_HOOKS=m
CONFIG_QCOM_MINIDUMP_PANIC_MEMORY_INFO=y
CONFIG_QCOM_SPMI_PMIC_ERR_DBG=m
CONFIG_SHOW_SUSPEND_EPOCH=m
CONFIG_QTI_C1DCVS_SCMI_V2=m
CONFIG_QTI_CPUFREQ_STATS_SCMI_V2=m
CONFIG_QTI_CPUFREQ_STATS_SCMI_V3=m
CONFIG_QTI_DYNPF_SCMI=m
CONFIG_QTI_MPAM_MSC=m
CONFIG_QTI_MPAM_MSC_SLC=m
CONFIG_QTI_SLC_MPAM_INTERFACE=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_CRYPTO_DEV_QCOM_RNG=m
CONFIG_USB_XHCI_SIDEBAND=y
CONFIG_SND_USB_AUDIO_QMI=m

# --- Disable unused debug/tracing overhead (keeps GKI KABI untouched) ---
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# CONFIG_CORESIGHT is not set
# CONFIG_STM is not set
# CONFIG_DRM_LT9611UXC is not set
# CONFIG_KUNIT is not set
# CONFIG_TIME_KUNIT_TEST is not set
